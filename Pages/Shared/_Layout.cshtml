<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pakonek Performance</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex">
        <aside class="sidebar text-white p-3" style="background-color: #0a2aa8;">
            <h4 class="mb-4"><i class="bi bi-graph-up-arrow"></i> Pakonek</h4>
            <nav class="nav flex-column">
                <a class="nav-link text-white" asp-page="/Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="nav-link text-white" asp-page="/Manager/Departments/Index"><i class="bi bi-building"></i> Departments</a>
                <a class="nav-link text-white" asp-page="/Manager/Employees/Index"><i class="bi bi-people"></i> Employees</a>
                <a class="nav-link text-white" asp-page="/Manager/Criteria/Index"><i class="bi bi-list-check"></i> Criteria</a>
                <a class="nav-link text-white" asp-page="/Manager/OfficeTask/Index"><i class="bi bi-card-checklist"></i> Office Tasks</a>
                <a class="nav-link text-white" asp-page="/Manager/JobTickets/Index"><i class="bi bi-tools"></i> Job Tickets</a>
                <a class="nav-link text-white" asp-page="/Manager/WorkLoadMonitoring/Index"><i class="bi bi-bar-chart-line"></i> Workload Monitoring</a>
            </nav>
        </aside>
        <main class="flex-grow-1 p-4 bg-light min-vh-100">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
