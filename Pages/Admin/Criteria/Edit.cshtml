@page "{id:int}"
@model TM_PE.Pages.Admin.Criteria.EditModel
@{
    ViewData["Title"] = "Edit Criteria";
    Layout = "_Admin";
}

<h2 class="mb-4">Edit Criteria</h2>
<div class="card p-4" style="max-width:700px">
    <form method="post">
        <input type="hidden" asp-for="Item.CriteriaId" />
        <div class="mb-3">
            <label class="form-label">Criteria Name</label>
            <input class="form-control" asp-for="Item.CriteriaName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" asp-for="Item.Description"></textarea>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Role Type</label>
                <select class="form-select" asp-for="Item.RoleType">
                    <option value="OfficeStaff">Office Staff</option>
                    <option value="FieldTechnician">Field Technician</option>
                </select>
            </div>
            @* <div class="col-md-6"><label class="form-label">Max Score</label>
            <input class="form-control" type="number" min="1" max="10" asp-for="Item.MaxScore" /></div> *@
        </div>
        <div class="form-check mt-3 mb-3">
            <input class="form-check-input" type="checkbox" asp-for="Item.IsActive" />
            <label class="form-check-label">Active</label>
        </div>
        <button class="btn btn-primary">Update</button>
        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
    </form>
</div>
