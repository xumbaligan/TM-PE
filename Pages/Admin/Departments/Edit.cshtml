@page "{id:int}"
@model TM_PE.Pages.Admin.Departments.EditModel
@{
    ViewData["Title"] = "Edit Department";
    Layout = "_Admin";
}

<h2 class="mb-4">Edit Department</h2>
<div class="card p-4" style="max-width:600px">
    <form method="post">
        <input type="hidden" asp-for="Department.DepartmentId" />
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input class="form-control" asp-for="Department.DepartmentName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" asp-for="Department.Description"></textarea>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" asp-for="Department.IsActive" />
            <label class="form-check-label">Active</label>
        </div>
        <button class="btn btn-primary">Update</button>
        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
    </form>
</div>
