@page
@model TM_PE.Pages.Manager.JobTickets.IndexModel
@{
    ViewData["Title"] = "Job Tickets";
    Layout = "_Layout";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Job Ticket Management</h3>
    <a asp-page="Create" class="btn btn-primary">
        + Create New
    </a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <input class="form-control" name="search" id="liveSearch"
               value="@Model.Search" placeholder="Search by leader, job type, ticket #, or client..." />
    </div>
    <div class="col-md-4">
        <select class="form-select" name="status" id="liveStatus">
            <option value="">All Statuses</option>
            <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
            <option value="In Progress" selected="@(Model.StatusFilter == "In Progress")">In Progress</option>
            <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
            <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
            <option value="Closed" selected="@(Model.StatusFilter == "Closed")">Closed</option>
            <option value="Rescheduled" selected="@(Model.StatusFilter == "Rescheduled")">Rescheduled</option>
        </select>
    </div>
</form>

<div class="table-responsive card">
    <table class="table align-middle table-hover mb-0">
        <thead>
            <tr class="text-muted small">
                <th>Task Number</th>
                <th>Job Type</th>
                <th>Client</th>
                <th>Leader</th>
                <th>Status</th>
                <th>Due Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.JobTicket.Any())
            {
                <tr id="emptyRow">
                    <td colspan="7" class="text-center text-muted py-4">No job tickets yet.</td>
                </tr>
            }
            else
            {
                <tr id="emptyRow" style="display:none;">
                    <td colspan="7" class="text-center text-muted py-4">No job tickets found</td>
                </tr>
            }
            @foreach (var item in Model.JobTicket)
            {
                var leader = item.Assignments?.FirstOrDefault(a => a.IsLeader)?.Employee;
                <tr data-leader="@(leader?.FullName.ToLower() ?? "")"
                    data-jobtype="@item.JobType.ToLower()"
                    data-ticketid="@item.TicketNumber.ToLower()"
                    data-client="@item.ClientFullName.ToLower()"
                    data-status="@item.Status.ToLower()">
                    <td class="text-muted">@item.TicketNumber</td>
                    <td class="fw-semibold">@item.JobType</td>
                    <td>@item.ClientFullName</td>
                    <td>@(leader != null ? leader.FullName : "—")</td>
                    <td>
                        @{
                            var badgeClass = item.Status switch
                            {
                                "Closed" => "bg-primary-subtle text-primary",
                                "Completed" => "bg-success-subtle text-success",
                                "In Progress" => "bg-info-subtle text-info",
                                "Cancelled" => "bg-danger-subtle text-danger",
                                "Rescheduled" => "bg-warning-subtle text-warning-emphasis",
                                _ => "bg-secondary-subtle text-secondary"
                            };
                        }
                        <span class="badge rounded-pill @badgeClass px-3 py-2">
                            @item.Status
                        </span>
                    </td>
                    <td class="text-muted">@item.ServiceDate.ToString("M/d/yyyy")</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-link text-secondary p-1" title="View"
                                data-bs-toggle="modal" data-bs-target="#viewModal-@item.JobTicketID">
                            <i class="bi bi-eye"></i>
                        </button>
                        @if (!item.IsLockedFromEditing)
                        {
                            <a asp-page="./Edit" asp-route-id="@item.JobTicketID"
                               class="btn btn-sm btn-link text-secondary p-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-sm btn-link text-muted p-1">
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ===================== VIEW MODALS ===================== *@
@foreach (var item in Model.JobTicket)
{
    var modalBadgeClass = item.Status switch
    {
        "Approved" => "bg-primary-subtle text-primary",
        "Completed" => "bg-success-subtle text-success",
        "In Progress" => "bg-info-subtle text-info",
        "Cancelled" => "bg-danger-subtle text-danger",
        "Rescheduled" => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-secondary-subtle text-secondary"
    };

    <div class="modal fade" id="viewModal-@item.JobTicketID" tabindex="-1"
         aria-labelledby="viewModalLabel-@item.JobTicketID" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="viewModalLabel-@item.JobTicketID">
                            @item.JobType
                        </h5>
                        <div class="text-muted small">Ticket #@item.TicketNumber</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <div class="row g-3 mb-4">
                        <div class="col-sm-4">
                            <div class="text-muted small">Status</div>
                            <span class="badge rounded-pill @modalBadgeClass px-3 py-2">
                                @item.Status
                            </span>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">Date Created</div>
                            <div>@item.DateCreated.ToString("M/d/yyyy")</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">@item.ServiceDateLabel</div>
                            <div>@item.ServiceDate.ToString("M/d/yyyy")</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-4">
                            <div class="text-muted small">Client</div>
                            <div>@item.ClientFullName</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">Primary Number</div>
                            <div>@item.PrimaryNumber</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">Secondary Number</div>
                            <div>@(string.IsNullOrWhiteSpace(item.SecondaryNumber) ? "—" : item.SecondaryNumber)</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        @if (item.JobType == "Installation")
                        {
                            <div class="col-sm-4">
                                <div class="text-muted small">Fiber Plan</div>
                                <div>₱@item.FiberPlan</div>
                            </div>
                            <div class="col-sm-8">
                                <div class="text-muted small">Location</div>
                                <div>@item.LocationAddress</div>
                            </div>
                        }
                        else
                        {
                            <div class="col-sm-4">
                                <div class="text-muted small">Description</div>
                                <div>@item.Description</div>
                            </div>
                            <div class="col-sm-8">
                                <div class="text-muted small">Location</div>
                                <div>@item.LocationAddress</div>
                            </div>
                        }
                    </div>

                    <div class="mb-2">
                        <div class="text-muted small mb-2">Assigned Field Technicians</div>
                        @if (item.Assignments != null && item.Assignments.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var a in item.Assignments.Where(a => a.Employee != null))
                                {
                                    <span class="badge rounded-pill @(a.IsLeader ? "bg-primary" : "bg-light text-dark border") px-3 py-2">
                                        @a.Employee!.FullName @(a.IsLeader ? "(Leader)" : "")
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">No assignees</span>
                        }
                    </div>

                </div>
                <div class="modal-footer">
                    <a asp-page="./Details" asp-route-id="@item.JobTicketID" class="btn btn-outline-primary btn-sm">
                        Open Full Details
                    </a>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const searchInput = document.getElementById('liveSearch');
        const statusSelect = document.getElementById('liveStatus');
        const rows = document.querySelectorAll('tbody tr[data-ticketid]');

        function filterTable() {
            const searchVal = searchInput.value.toLowerCase().trim();
            const statusVal = statusSelect.value.toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const leader = row.dataset.leader || '';
                const jobType = row.dataset.jobtype || '';
                const ticketId = row.dataset.ticketid || '';
                const client = row.dataset.client || '';
                const status = row.dataset.status || '';

                const matchesSearch = leader.includes(searchVal) || jobType.includes(searchVal)
                    || ticketId.includes(searchVal) || client.includes(searchVal);
                const matchesStatus = statusVal === '' || status === statusVal;

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const emptyRow = document.getElementById('emptyRow');
            if (emptyRow) {
                emptyRow.style.display = visibleCount === 0 ? '' : 'none';
            }
        }

        searchInput.addEventListener('input', filterTable);
        statusSelect.addEventListener('change', filterTable);
    </script>
}
