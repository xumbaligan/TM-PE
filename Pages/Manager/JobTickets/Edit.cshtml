@page "{id:int}"
@model TM_PE.Pages.Manager.JobTickets.EditModel

@{
    ViewData["Title"] = "Edit Job Ticket";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <h3 class="fw-bold">Edit Job Ticket</h3>
        <p class="text-muted">
            Update the job details below. Assigned field technicians can't be added or removed here.
        </p>

        <form method="post" id="ticketForm">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="JobTicket.JobTicketID" />

            <!-- Task Number + Date Created -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold"># Task Number</label>
                    <input class="form-control" value="@Model.JobTicket.TicketNumber" disabled />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Date Created</label>
                    <input type="date" class="form-control" value="@Model.JobTicket.DateCreated.ToString("yyyy-MM-dd")" disabled />
                </div>
            </div>

            <!-- Job Type -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Job Type <span class="text-danger">*</span></label>
                <select asp-for="JobTicket.JobType" id="jobTypeSelect" class="form-select">
                    @foreach (var type in Model.JobTypeOptions)
                    {
                        <option value="@type" selected="@(type == Model.JobTicket.JobType)">@type</option>
                    }
                </select>
                <span asp-validation-for="JobTicket.JobType" class="text-danger"></span>
            </div>

            <!-- Client Info -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Full Name (Client) <span class="text-danger">*</span></label>
                    <input asp-for="JobTicket.ClientFullName" class="form-control" />
                    <span asp-validation-for="JobTicket.ClientFullName" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Primary Number <span class="text-danger">*</span></label>
                    <input asp-for="JobTicket.PrimaryNumber" class="form-control" />
                    <span asp-validation-for="JobTicket.PrimaryNumber" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Secondary Number</label>
                    <input asp-for="JobTicket.SecondaryNumber" class="form-control" />
                    <span asp-validation-for="JobTicket.SecondaryNumber" class="text-danger"></span>
                </div>
            </div>

            <!-- Fiber Plan (Installation) / Description (Repair, Maintenance) + Date + Status -->
            <div class="row mb-3">
                <div class="col-md-4" id="fiberPlanGroup">
                    <label class="form-label fw-semibold">Fiber Plan <span class="text-danger">*</span></label>
                    <select asp-for="JobTicket.FiberPlan" id="fiberPlanSelect" class="form-select">
                        <option value="">Select a plan</option>
                        @foreach (var plan in Model.FiberPlanOptions)
                        {
                            <option value="@plan" selected="@(plan == Model.JobTicket.FiberPlan)">₱@plan / month</option>
                        }
                    </select>
                    <span asp-validation-for="JobTicket.FiberPlan" class="text-danger"></span>
                </div>

                <div class="col-md-4 d-none" id="descriptionGroup">
                    <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                    <textarea asp-for="JobTicket.Description" id="descriptionInput" class="form-control" rows="1" maxlength="500"></textarea>
                    <span asp-validation-for="JobTicket.Description" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold" id="serviceDateLabel">Date of Installation <span class="text-danger">*</span></label>
                    <input asp-for="JobTicket.ServiceDate" type="date"
                           value="@Model.JobTicket.ServiceDate.ToString("yyyy-MM-dd")"
                           class="form-control" />
                    <span asp-validation-for="JobTicket.ServiceDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Status</label>
                    <select asp-for="JobTicket.Status" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>

            <!-- Location Map -->
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="fw-semibold mb-2">📍 Job Location <span class="text-danger">*</span></h5>
                    <p class="text-muted small mb-2">Search for an address or click on the map to re-pin the job site if needed.</p>

                    <div class="input-group mb-2">
                        <input type="text" id="locationSearch" class="form-control" placeholder="Search for an address..." autocomplete="off" />
                        <button type="button" id="locationSearchBtn" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                    <div id="locationSearchResults" class="list-group mb-2" style="max-height:180px; overflow-y:auto;"></div>

                    <div id="locationMap" style="height:320px; border-radius:8px;"></div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold">Exact Address</label>
                        <input asp-for="JobTicket.LocationAddress" id="locationAddress" class="form-control" readonly />
                        <span asp-validation-for="JobTicket.LocationAddress" class="text-danger"></span>
                    </div>

                    <input type="hidden" asp-for="JobTicket.Latitude" id="locationLat" />
                    <input type="hidden" asp-for="JobTicket.Longitude" id="locationLng" />
                </div>
            </div>

            <!-- Assignees (read-only) -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="fw-semibold mb-3">👷 Assigned Field Technicians</h5>
                    @if (Model.JobTicket.Assignments != null && Model.JobTicket.Assignments.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var a in Model.JobTicket.Assignments.Where(a => a.Employee != null))
                            {
                                <span class="badge rounded-pill @(a.IsLeader ? "bg-primary" : "bg-light text-dark border") px-3 py-2">
                                    @a.Employee!.FullName @(a.IsLeader ? "(Leader)" : "")
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">No assignees</span>
                    }
                    <p class="text-muted small mt-2 mb-0">Assignees are fixed at creation and can't be changed from this page.</p>
                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="text-end">
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        (function () {
            const startLat = @Model.JobTicket.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const startLng = @Model.JobTicket.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const hasStart = startLat !== 0 && startLng !== 0;

            const map = L.map('locationMap').setView(hasStart ? [startLat, startLng] : [14.6760, 121.0437], hasStart ? 16 : 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const latInput = document.getElementById('locationLat');
            const lngInput = document.getElementById('locationLng');
            const addressInput = document.getElementById('locationAddress');

            let marker = hasStart ? L.marker([startLat, startLng], { draggable: true }).addTo(map) : null;
            if (marker) {
                marker.on('dragend', function () {
                    const pos = marker.getLatLng();
                    latInput.value = pos.lat;
                    lngInput.value = pos.lng;
                    reverseGeocode(pos.lat, pos.lng);
                });
            }

            async function reverseGeocode(lat, lng) {
                addressInput.value = 'Looking up address...';
                try {
                    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
                    const data = await res.json();
                    addressInput.value = data && data.display_name ? data.display_name : `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                } catch (err) {
                    addressInput.value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                }
            }

            function setPin(lat, lng) {
                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                    marker.on('dragend', function () {
                        const pos = marker.getLatLng();
                        latInput.value = pos.lat;
                        lngInput.value = pos.lng;
                        reverseGeocode(pos.lat, pos.lng);
                    });
                }
                latInput.value = lat;
                lngInput.value = lng;
                reverseGeocode(lat, lng);
            }

            map.on('click', function (e) {
                setPin(e.latlng.lat, e.latlng.lng);
            });

            // ---------------- ADDRESS SEARCH ----------------
            const locationSearch = document.getElementById('locationSearch');
            const locationSearchBtn = document.getElementById('locationSearchBtn');
            const locationSearchResults = document.getElementById('locationSearchResults');

            async function searchAddress() {
                const query = locationSearch.value.trim();
                locationSearchResults.innerHTML = '';
                if (!query) return;

                try {
                    const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=5&q=${encodeURIComponent(query)}`);
                    const results = await res.json();

                    if (!results || results.length === 0) {
                        locationSearchResults.innerHTML = '<div class="list-group-item small text-muted">No matches found.</div>';
                        return;
                    }

                    results.forEach(function (r) {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'list-group-item list-group-item-action small';
                        item.textContent = r.display_name;
                        item.addEventListener('click', function () {
                            const lat = parseFloat(r.lat);
                            const lng = parseFloat(r.lon);
                            map.setView([lat, lng], 17);
                            setPin(lat, lng);
                            locationSearchResults.innerHTML = '';
                            locationSearch.value = r.display_name;
                        });
                        locationSearchResults.appendChild(item);
                    });
                } catch (err) {
                    locationSearchResults.innerHTML = '<div class="list-group-item small text-danger">Search failed. Please try again.</div>';
                }
            }

            locationSearchBtn.addEventListener('click', searchAddress);
            locationSearch.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    searchAddress();
                }
            });

            // ---------------- JOB TYPE TOGGLE ----------------
            const jobTypeSelect = document.getElementById('jobTypeSelect');
            const fiberPlanGroup = document.getElementById('fiberPlanGroup');
            const fiberPlanSelect = document.getElementById('fiberPlanSelect');
            const descriptionGroup = document.getElementById('descriptionGroup');
            const descriptionInput = document.getElementById('descriptionInput');
            const serviceDateLabel = document.getElementById('serviceDateLabel');

            function applyJobType() {
                const type = jobTypeSelect.value;
                if (type === 'Repair') {
                    fiberPlanGroup.classList.add('d-none');
                    descriptionGroup.classList.remove('d-none');
                    fiberPlanSelect.removeAttribute('required');
                    descriptionInput.setAttribute('required', 'required');
                    serviceDateLabel.innerHTML = 'Date of Repair <span class="text-danger">*</span>';
                } else if (type === 'Maintenance') {
                    fiberPlanGroup.classList.add('d-none');
                    descriptionGroup.classList.remove('d-none');
                    fiberPlanSelect.removeAttribute('required');
                    descriptionInput.setAttribute('required', 'required');
                    serviceDateLabel.innerHTML = 'Date of Maintenance <span class="text-danger">*</span>';
                } else {
                    fiberPlanGroup.classList.remove('d-none');
                    descriptionGroup.classList.add('d-none');
                    fiberPlanSelect.setAttribute('required', 'required');
                    descriptionInput.removeAttribute('required');
                    serviceDateLabel.innerHTML = 'Date of Installation <span class="text-danger">*</span>';
                }
            }

            jobTypeSelect.addEventListener('change', applyJobType);
            applyJobType();
        })();
    </script>
}
