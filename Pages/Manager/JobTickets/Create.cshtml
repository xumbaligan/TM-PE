@page
@model TM_PE.Pages.Manager.JobTickets.CreateModel

@{
    ViewData["Title"] = "Create Job Ticket";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <h3 class="fw-bold">Job Ticket Form</h3>
        <p class="text-muted">
            Fill out the job details, pin the installation location, and assign field technicians.
        </p>

        <form method="post" id="ticketForm">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <!-- ID Number + Date Created -->
            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        # Task Number
                    </label>

                    <input class="form-control"
                           value="@Model.NextTicketNumber"
                           disabled />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Date Created
                    </label>

                    <input type="date"
                           class="form-control"
                           value="@Model.JobTicket.DateCreated.ToString("yyyy-MM-dd")"
                           disabled />

                    <input type="hidden" asp-for="JobTicket.DateCreated" />
                </div>

            </div>

            <!-- Job Name -->
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Job Name <span class="text-danger">*</span>
                </label>

                <input asp-for="JobTicket.JobName"
                       class="form-control"
                       placeholder="e.g. New Fiber Installation" />

                <span asp-validation-for="JobTicket.JobName" class="text-danger"></span>
            </div>

            <!-- Client Info -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Full Name (Client) <span class="text-danger">*</span>
                    </label>

                    <input asp-for="JobTicket.ClientFullName"
                           class="form-control"
                           placeholder="e.g. Juan Dela Cruz" />

                    <span asp-validation-for="JobTicket.ClientFullName" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Primary Number <span class="text-danger">*</span>
                    </label>

                    <input asp-for="JobTicket.PrimaryNumber"
                           class="form-control"
                           placeholder="09xx xxx xxxx" />

                    <span asp-validation-for="JobTicket.PrimaryNumber" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Secondary Number
                    </label>

                    <input asp-for="JobTicket.SecondaryNumber"
                           class="form-control"
                           placeholder="Optional" />

                    <span asp-validation-for="JobTicket.SecondaryNumber" class="text-danger"></span>
                </div>
            </div>

            <!-- Fiber Plan + Installation Date -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Fiber Plan <span class="text-danger">*</span>
                    </label>

                    <select asp-for="JobTicket.FiberPlan" class="form-select">
                        <option value="">Select a plan</option>
                        @foreach (var plan in Model.FiberPlanOptions)
                        {
                            <option value="@plan">₱@plan / month</option>
                        }
                    </select>

                    <span asp-validation-for="JobTicket.FiberPlan" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Date of Installation <span class="text-danger">*</span>
                    </label>

                    <input asp-for="JobTicket.InstallationDate"
                           type="date"
                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                           value="@Model.JobTicket.InstallationDate.ToString("yyyy-MM-dd")"
                           class="form-control" />

                    <span asp-validation-for="JobTicket.InstallationDate" class="text-danger"></span>
                </div>
            </div>

            <!-- Location Map -->
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="fw-semibold mb-2">
                        📍 Job Location <span class="text-danger">*</span>
                    </h5>
                    <p class="text-muted small mb-2">Click on the map to pin the exact job site. The address below fills in automatically.</p>

                    <div id="locationMap" style="height:320px; border-radius:8px;"></div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold">Exact Address</label>
                        <input asp-for="JobTicket.LocationAddress"
                               id="locationAddress"
                               class="form-control"
                               placeholder="Pin a location on the map above"
                               readonly />
                        <span asp-validation-for="JobTicket.LocationAddress" class="text-danger"></span>
                    </div>

                    <input type="hidden" asp-for="JobTicket.Latitude" id="locationLat" />
                    <input type="hidden" asp-for="JobTicket.Longitude" id="locationLng" />
                </div>
            </div>

            <!-- Add Assignees -->
            <div class="card mb-4">
                <div class="card-body">

                    <h5 class="fw-semibold mb-1">
                        👷 Add Assignees <span class="text-danger">*</span>
                    </h5>
                    <p class="text-muted small mb-3">Only Field Technicians can be assigned to a job ticket. Pick one to be the leader.</p>

                    <div class="row">
                        <div class="col-md-10">
                            <select id="employeeSelect" class="form-select">
                                <option value="">Select a field technician</option>
                                @foreach (var emp in Model.FieldTechnicianList)
                                {
                                    <option value="@emp.EmployeeId">@emp.FullName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button type="button" id="addEmployeeBtn" class="btn btn-primary w-100">
                                + Add
                            </button>
                        </div>
                    </div>

                    <!-- Selected Employees -->
                    <div id="selectedEmployees" class="mt-3 d-flex flex-column gap-2">
                        <span class="text-muted small" id="noEmployeesMsg">No field technicians added yet.</span>
                    </div>

                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="text-end">
                <a asp-page="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    Save Job Ticket
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        (function () {
            // ---------------- MAP ----------------
            const defaultLatLng = [10.2764,123.8497]; // Bulacao, PH fallback center
            const map = L.map('locationMap').setView(defaultLatLng, 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            let marker = null;
            const latInput = document.getElementById('locationLat');
            const lngInput = document.getElementById('locationLng');
            const addressInput = document.getElementById('locationAddress');

            async function reverseGeocode(lat, lng) {
                addressInput.value = 'Looking up address...';
                try {
                    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
                    const data = await res.json();
                    addressInput.value = data && data.display_name ? data.display_name : `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                } catch (err) {
                    addressInput.value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                }
            }

            function setPin(lat, lng) {
                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                    marker.on('dragend', function () {
                        const pos = marker.getLatLng();
                        latInput.value = pos.lat;
                        lngInput.value = pos.lng;
                        reverseGeocode(pos.lat, pos.lng);
                    });
                }
                latInput.value = lat;
                lngInput.value = lng;
                reverseGeocode(lat, lng);
            }

            map.on('click', function (e) {
                setPin(e.latlng.lat, e.latlng.lng);
            });

            // ---------------- ASSIGNEES + LEADER ----------------
            const employeeSelect = document.getElementById('employeeSelect');
            const addEmployeeBtn = document.getElementById('addEmployeeBtn');
            const selectedEmployeesDiv = document.getElementById('selectedEmployees');
            const noEmployeesMsg = document.getElementById('noEmployeesMsg');

            // id -> name, preserves insertion order
            const addedEmployees = new Map();
            let leaderId = null;

            function renderEmployeeRow(id, name) {
                const row = document.createElement('div');
                row.className = 'd-flex align-items-center gap-2 border rounded p-2';
                row.dataset.employeeId = id;
                row.innerHTML = `
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="radio" name="leaderRadio" id="leaderRadio-${id}" ${leaderId === id ? 'checked' : ''}>
                        <label class="form-check-label small" for="leaderRadio-${id}">Leader</label>
                    </div>
                    <span class="flex-grow-1">${name}</span>
                    <span class="text-danger" style="cursor:pointer;" title="Remove">&times;</span>
                    <input type="hidden" name="SelectedEmployeeIds" value="${id}" />
                `;

                row.querySelector('input[type=radio]').addEventListener('change', function () {
                    leaderId = id;
                    document.getElementById('leaderEmployeeIdInput').value = id;
                });

                row.querySelector('.text-danger').addEventListener('click', function () {
                    addedEmployees.delete(id);
                    row.remove();
                    if (leaderId === id) {
                        leaderId = null;
                        document.getElementById('leaderEmployeeIdInput').value = '';
                        // Auto-promote the next remaining technician to leader, if any
                        const remaining = [...addedEmployees.keys()];
                        if (remaining.length > 0) {
                            leaderId = remaining[0];
                            document.getElementById('leaderEmployeeIdInput').value = leaderId;
                            const nextRadio = document.getElementById(`leaderRadio-${leaderId}`);
                            if (nextRadio) nextRadio.checked = true;
                        }
                    }
                    if (addedEmployees.size === 0) {
                        noEmployeesMsg.style.display = '';
                    }
                });

                selectedEmployeesDiv.appendChild(row);
            }

            // Hidden input carrying the chosen leader's EmployeeId
            const leaderHidden = document.createElement('input');
            leaderHidden.type = 'hidden';
            leaderHidden.id = 'leaderEmployeeIdInput';
            leaderHidden.name = 'LeaderEmployeeId';
            leaderHidden.value = '';
            document.getElementById('ticketForm').appendChild(leaderHidden);

            addEmployeeBtn.addEventListener('click', function () {
                const id = employeeSelect.value;
                const name = employeeSelect.options[employeeSelect.selectedIndex].text;

                if (!id) return;
                if (addedEmployees.has(id)) return;

                addedEmployees.set(id, name);
                noEmployeesMsg.style.display = 'none';

                renderEmployeeRow(id, name);

                // First technician added is auto-selected as leader
                if (addedEmployees.size === 1) {
                    leaderId = id;
                    leaderHidden.value = id;
                    document.getElementById(`leaderRadio-${id}`).checked = true;
                }

                employeeSelect.value = '';
            });

            document.getElementById('ticketForm').addEventListener('submit', function (e) {
                if (!latInput.value || !lngInput.value) {
                    e.preventDefault();
                    alert('Please pin the job location on the map.');
                    return;
                }
                if (addedEmployees.size === 0) {
                    e.preventDefault();
                    alert('Please add at least one field technician.');
                    return;
                }
                if (!leaderHidden.value) {
                    e.preventDefault();
                    alert('Please choose a leader among the assigned field technicians.');
                }
            });
        })();
    </script>
}
