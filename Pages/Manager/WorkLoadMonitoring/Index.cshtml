@page
@model TM_PE.Pages.Manager.WorkLoadMonitoring.IndexModel
@{
    ViewData["Title"] = "Workload Monitoring";
    Layout = "_Layout";
}

<h2 class="mb-4">Workload Monitoring</h2>

<ul class="nav nav-tabs mb-3" id="wlmTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tickets-tab" data-bs-toggle="tab" data-bs-target="#tickets-pane"
                type="button" role="tab" aria-controls="tickets-pane" aria-selected="true">
            <i class="bi bi-tools"></i> Active Tickets per Technician
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tasks-tab" data-bs-toggle="tab" data-bs-target="#tasks-pane"
                type="button" role="tab" aria-controls="tasks-pane" aria-selected="false">
            <i class="bi bi-card-checklist"></i> Active Tasks per Staff
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="summary-tab" data-bs-toggle="tab" data-bs-target="#summary-pane"
                type="button" role="tab" aria-controls="summary-pane" aria-selected="false">
            <i class="bi bi-bar-chart-line"></i> Employee Workload Summary
        </button>
    </li>
</ul>

<div class="tab-content" id="wlmTabsContent">

    @* ===================== View 1: Active Tickets per Technician ===================== *@
    <div class="tab-pane fade show active" id="tickets-pane" role="tabpanel" aria-labelledby="tickets-tab">
            @if (!Model.TechnicianTickets.Any())
            {
                <p class="text-muted small mb-0">No active Field Technicians to monitor yet.</p>
            }
            else
            {
                <div class="table-responsive card">
                    <table class="table align-middle table-hover mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Technician</th>
                                <th>Department</th>
                                <th class="text-center">Active Tickets</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.TechnicianTickets)
                            {
                                <tr>
                                    <td class="fw-semibold">@t.FullName</td>
                                    <td class="text-muted">@t.DepartmentName</td>
                                    <td class="text-center">
                                        @if (t.ActiveTicketCount > 0)
                                        {
                                            <span class="badge badge-soft-primary">@t.ActiveTicketCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary technician-view-btn"
                                                data-bs-toggle="modal" data-bs-target="#technicianModal"
                                                data-name="@t.FullName"
                                                data-department="@t.DepartmentName"
                                                data-active="@t.ActiveTicketCount"
                                                data-tickets="@System.Text.Json.JsonSerializer.Serialize(t.Tickets)">
                                            <i class="bi bi-eye"></i> View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
    </div>

    @* ===================== View 2: Active Tasks per Office Staff ===================== *@
    <div class="tab-pane fade" id="tasks-pane" role="tabpanel" aria-labelledby="tasks-tab">
            @if (!Model.StaffTasks.Any())
            {
                <p class="text-muted small mb-0">No active Office Staff to monitor yet.</p>
            }
            else
            {
                <div class="table-responsive card">
                <table class="table align-middle table-hover mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Staff</th>
                                <th>Department</th>
                                <th class="text-center">Active Tasks</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.StaffTasks)
                            {
                                <tr>
                                    <td class="fw-semibold">@s.FullName</td>
                                    <td class="text-muted">@s.DepartmentName</td>
                                    <td class="text-center">
                                        @if (s.ActiveTaskCount > 0)
                                        {
                                            <span class="badge badge-soft-primary">@s.ActiveTaskCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary staff-view-btn"
                                                data-bs-toggle="modal" data-bs-target="#staffModal"
                                                data-name="@s.FullName"
                                                data-department="@s.DepartmentName"
                                                data-active="@s.ActiveTaskCount"
                                                data-tasks="@System.Text.Json.JsonSerializer.Serialize(s.Tasks)">
                                            <i class="bi bi-eye"></i> View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
    </div>

    @* ===================== View 3: Employee Workload Summary ===================== *@
    <div class="tab-pane fade" id="summary-pane" role="tabpanel" aria-labelledby="summary-tab">
        <div class="card p-3 mb-3">
            <h6 class="mb-3">Office Staff Workload</h6>
            @if (!Model.Workload.Any())
            {
                <p class="text-muted small mb-0">No active Office Staff to monitor yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Employee</th>
                                <th>Department</th>
                                <th class="text-center">Active Tasks</th>
                                <th class="text-center">Overdue</th>
                                <th class="text-center">Completed</th>
                                <th class="text-center">Pending Activities</th>
                                <th class="text-center">Avg. Score</th>
                                <th style="width:220px;">Workload</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var w in Model.Workload)
                            {
                                var levelClass = w.WorkloadLevel switch
                                {
                                    "Heavy" => "bg-danger-subtle text-danger",
                                    "Moderate" => "bg-warning-subtle text-warning",
                                    _ => "bg-success-subtle text-success"
                                };
                                var barClass = w.WorkloadLevel switch
                                {
                                    "Heavy" => "bg-danger",
                                    "Moderate" => "bg-warning",
                                    _ => "bg-success"
                                };
                                // Cap the visual bar at a reasonable ceiling so one very
                                // heavy workload doesn't flatten everyone else's bar.
                                var barPercent = Math.Min(100, w.WorkloadPoints * 10);

                                <tr>
                                    <td class="fw-semibold">@w.FullName</td>
                                    <td class="text-muted">@w.DepartmentName</td>
                                    <td class="text-center">@w.ActiveTasks</td>
                                    <td class="text-center">
                                        @if (w.OverdueTasks > 0)
                                        {
                                            <span class="text-danger fw-semibold">@w.OverdueTasks</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">@w.CompletedTasks</td>
                                    <td class="text-center">@w.PendingActivities</td>
                                    <td class="text-center">@w.AvgScore%</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:8px;">
                                                <div class="progress-bar @barClass" style="width:@(barPercent)%"></div>
                                            </div>
                                            <span class="badge rounded-pill @levelClass px-2">@w.WorkloadLevel</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card p-3">
            <h6 class="mb-3">Field Technician Workload</h6>
            @if (!Model.TechnicianWorkload.Any())
            {
                <p class="text-muted small mb-0">No active Field Technicians to monitor yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Technician</th>
                                <th>Department</th>
                                <th class="text-center">Active Tickets</th>
                                <th class="text-center">Overdue</th>
                                <th class="text-center">Completed</th>
                                <th style="width:220px;">Workload</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var w in Model.TechnicianWorkload)
                            {
                                var levelClass = w.WorkloadLevel switch
                                {
                                    "Heavy" => "bg-danger-subtle text-danger",
                                    "Moderate" => "bg-warning-subtle text-warning",
                                    _ => "bg-success-subtle text-success"
                                };
                                var barClass = w.WorkloadLevel switch
                                {
                                    "Heavy" => "bg-danger",
                                    "Moderate" => "bg-warning",
                                    _ => "bg-success"
                                };
                                var barPercent = Math.Min(100, w.WorkloadPoints * 10);

                                <tr>
                                    <td class="fw-semibold">@w.FullName</td>
                                    <td class="text-muted">@w.DepartmentName</td>
                                    <td class="text-center">@w.ActiveTickets</td>
                                    <td class="text-center">
                                        @if (w.OverdueTickets > 0)
                                        {
                                            <span class="text-danger fw-semibold">@w.OverdueTickets</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">@w.CompletedTickets</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:8px;">
                                                <div class="progress-bar @barClass" style="width:@(barPercent)%"></div>
                                            </div>
                                            <span class="badge rounded-pill @levelClass px-2">@w.WorkloadLevel</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

@* ===================== Modal: Technician Ticket Details ===================== *@
<div class="modal fade" id="technicianModal" tabindex="-1" aria-labelledby="technicianModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="technicianModalLabel"><i class="bi bi-person-badge"></i> <span id="technicianModalName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3 small">
                    <div class="col-sm-6">
                        <div class="text-muted">Department</div>
                        <div class="fw-semibold" id="technicianModalDepartment"></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted">Active Job Tickets</div>
                        <div class="fw-semibold" id="technicianModalActive"></div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-sm">
                        <thead>
                            <tr class="text-muted small">
                                <th>Ticket Details</th>
                            </tr>
                        </thead>
                        <tbody id="technicianModalTicketList">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-left"></i> Back
                </button>
                <a href="/Manager/JobTickets/Index" class="btn btn-primary">
                    <i class="bi bi-box-arrow-up-right"></i> Open Task
                </a>
            </div>
        </div>
    </div>
</div>

@* ===================== Modal: Office Staff Task Details ===================== *@
<div class="modal fade" id="staffModal" tabindex="-1" aria-labelledby="staffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staffModalLabel"><i class="bi bi-person-badge"></i> <span id="staffModalName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3 small">
                    <div class="col-sm-6">
                        <div class="text-muted">Department</div>
                        <div class="fw-semibold" id="staffModalDepartment"></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted">Active Tasks</div>
                        <div class="fw-semibold" id="staffModalActive"></div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-sm">
                        <thead>
                            <tr class="text-muted small">
                                <th>Ticket Details</th>
                            </tr>
                        </thead>
                        <tbody id="staffModalTaskList">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-left"></i> Back
                </button>
                <a href="/Manager/OfficeTask/Index" class="btn btn-primary">
                    <i class="bi bi-box-arrow-up-right"></i> Open Task
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
    <script>
        (function () {
            // ---- Technician "View" modal ----
            const technicianModal = document.getElementById('technicianModal');
            if (technicianModal) {
                technicianModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;

                    const tickets = JSON.parse(btn.getAttribute('data-tickets') || '[]');

                    document.getElementById('technicianModalName').textContent = btn.getAttribute('data-name') || '';
                    document.getElementById('technicianModalDepartment').textContent = btn.getAttribute('data-department') || '';
                    document.getElementById('technicianModalActive').textContent = btn.getAttribute('data-active') || '0';

                    const list = document.getElementById('technicianModalTicketList');
                    list.innerHTML = '';

                    if (tickets.length === 0) {
                        list.innerHTML = '<tr><td class="text-muted small">No active tickets</td></tr>';
                        return;
                    }

                    tickets.forEach(t => {
                        const statusClass = t.Status === 'In Progress'
                            ? 'bg-warning-subtle text-warning'
                            : 'bg-secondary-subtle text-secondary';
                        const serviceDate = new Date(t.ServiceDate).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });

                        const row = document.createElement('tr');
                        row.innerHTML = `<td class="small">
                            <span class="fw-semibold">${t.TicketNumber}</span>
                            — ${t.JobType} for ${t.ClientFullName}
                            <span class="badge rounded-pill ${statusClass} ms-1">${t.Status}</span>
                            <span class="text-muted">(${serviceDate})</span>
                        </td>`;
                        list.appendChild(row);
                    });
                });
            }

            // ---- Office Staff "View" modal ----
            const staffModal = document.getElementById('staffModal');
            if (staffModal) {
                staffModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;

                    const tasks = JSON.parse(btn.getAttribute('data-tasks') || '[]');

                    document.getElementById('staffModalName').textContent = btn.getAttribute('data-name') || '';
                    document.getElementById('staffModalDepartment').textContent = btn.getAttribute('data-department') || '';
                    document.getElementById('staffModalActive').textContent = btn.getAttribute('data-active') || '0';

                    const list = document.getElementById('staffModalTaskList');
                    list.innerHTML = '';

                    if (tasks.length === 0) {
                        list.innerHTML = '<tr><td class="text-muted small">No active tasks</td></tr>';
                        return;
                    }

                    tasks.forEach(t => {
                        const statusClass = t.Status === 'Overdue'
                            ? 'bg-danger-subtle text-danger'
                            : t.Status === 'In Progress'
                                ? 'bg-warning-subtle text-warning'
                                : 'bg-secondary-subtle text-secondary';
                        const dueDate = new Date(t.DueDate).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });

                        const row = document.createElement('tr');
                        row.innerHTML = `<td class="small">
                            <span class="fw-semibold">${t.TaskNumber}</span>
                            — ${t.TaskName}
                            <span class="badge rounded-pill ${statusClass} ms-1">${t.Status}</span>
                            <span class="text-muted">(due ${dueDate})</span>
                        </td>`;
                        list.appendChild(row);
                    });
                });
            }
        })();

        (function () {
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Workload.Select(w => w.FullName)));
            const points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Workload.Select(w => w.WorkloadPoints)));
            const levels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Workload.Select(w => w.WorkloadLevel)));

            const colorFor = level => level === 'Heavy' ? '#dc3545'
                : level === 'Moderate' ? '#ffc107'
                : '#198754';

            let chart = null;

            function renderChart() {
                if (chart || !document.getElementById('workloadChart')) return;
                chart = new Chart(document.getElementById('workloadChart'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Workload Points',
                            data: points,
                            backgroundColor: levels.map(colorFor),
                            borderRadius: 4,
                            maxBarThickness: 48
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    afterLabel: ctx => 'Level: ' + levels[ctx.dataIndex]
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }

            // Chart.js can't size a canvas correctly while its tab pane is hidden,
            // so build it only once the Workload Summary tab is actually shown.
            const summaryTab = document.getElementById('summary-tab');
            if (summaryTab) {
                summaryTab.addEventListener('shown.bs.tab', renderChart);
            }
        })();
    </script>
}
