@page "{id:int}"
@model TM_PE.Pages.OfficeTask.DetailsModel
@{
    ViewData["Title"] = "Task Records";
    var badgeClass = Model.OfficeTask.Status switch
    {
        "Completed" => "bg-success-subtle text-success",
        "In Progress" => "bg-info-subtle text-info",
        "Overdue" => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}

<div class="container mt-4" style="max-width: 900px;">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-clipboard-data me-1"></i>@Model.OfficeTask.TaskName
                        <span class="badge bg-light text-dark border ms-1">TSK-@Model.OfficeTask.OfficeTaskID.ToString("D5")</span>
                    </h5>
                    <div class="text-muted small">View task details and manage assignees and activities.</div>
                </div>
                <a asp-page="./Index" class="btn-close" aria-label="Close"></a>
            </div>

            <hr />

            <div class="row g-3 mb-2">
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Status</div>
                    <span class="badge rounded-pill @badgeClass px-3 py-2">@Model.OfficeTask.Status</span>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Progress</div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height:8px; min-width:80px;">
                            <div class="progress-bar" role="progressbar"
                                 style="width:@(Model.OfficeTask.Progress)%;"
                                 aria-valuenow="@Model.OfficeTask.Progress" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                        <span class="text-muted small">@Model.OfficeTask.Progress%</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Approved</div>
                    <div class="fw-semibold">
                        @(Model.OfficeTask.Activities?.Count(a => a.Status == "Approved") ?? 0)/@(Model.OfficeTask.Activities?.Count ?? 0)
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Date Assigned</div>
                    <div>@Model.OfficeTask.DateCreated.ToString("M/d/yyyy")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Due Date</div>
                    <div>@Model.OfficeTask.DueDate.ToString("M/d/yyyy")</div>
                </div>
            </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Date Assigned</div>
                    <div>@Model.OfficeTask.DateCreated.ToString("M/d/yyyy")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Due Date</div>
                    <div>@Model.OfficeTask.DueDate.ToString("M/d/yyyy")</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.OfficeTask.Description))
            {
                <div class="mt-2">
                    <div class="text-muted small">Description</div>
                    <div>@Model.OfficeTask.Description</div>
                </div>
            }
        </div>
    </div>

    @* ===================== ASSIGNED EMPLOYEES ===================== *@
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-people me-1"></i> Assigned Employees</h6>

            <form method="post" asp-page-handler="AddEmployee" class="d-flex gap-2 mb-3">
                <input type="hidden" name="officeTaskId" value="@Model.OfficeTask.OfficeTaskID" />
                <select name="employeeId" class="form-select">
                    <option value="">Select an employee to add</option>
                    @foreach (var emp in Model.AvailableEmployees)
                    {
                        <option value="@emp.EmployeeId">@emp.FullName</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-lg"></i> Add
                </button>
            </form>

            <div class="d-flex flex-wrap gap-2">
                @if (Model.OfficeTask.Assignments != null && Model.OfficeTask.Assignments.Any())
                {
                    @foreach (var a in Model.OfficeTask.Assignments.Where(a => a.Employee != null))
                    {
                        <span class="badge rounded-pill bg-light text-dark border px-3 py-2 d-inline-flex align-items-center gap-2">
                            @a.Employee!.FullName
                            <form method="post" asp-page-handler="RemoveEmployee" class="d-inline m-0 p-0">
                                <input type="hidden" name="taskAssignmentId" value="@a.TaskAssignmentID" />
                                <input type="hidden" name="officeTaskId" value="@Model.OfficeTask.OfficeTaskID" />
                                <button type="submit" class="btn btn-sm btn-link text-muted p-0" style="line-height:1;" title="Remove">
                                    <i class="bi bi-x"></i>
                                </button>
                            </form>
                        </span>
                    }
                }
                else
                {
                    <span class="text-muted small">No employees assigned yet.</span>
                }
            </div>
        </div>
    </div>

    @* ===================== ACTIVITIES & SUBMISSIONS ===================== *@
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-arrow-return-right me-1"></i> Activities &amp; Submissions</h6>

            <form method="post" asp-page-handler="AddActivity" class="d-flex gap-2 mb-3">
                <input type="hidden" name="officeTaskId" value="@Model.OfficeTask.OfficeTaskID" />
                <input type="text" name="activityName" class="form-control" placeholder="Enter a new activity" required />
                <button type="submit" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-lg"></i> Add
                </button>
            </form>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr class="text-muted small">
                            <th>Activity</th>
                            <th style="width:160px;">Status</th>
                            <th style="width:160px;">Submission</th>
                            <th style="width:220px;">Feedback</th>
                            <th class="text-end" style="width:60px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OfficeTask.Activities != null && Model.OfficeTask.Activities.Any())
                        {
                            @foreach (var activity in Model.OfficeTask.Activities)
                            {
                                var selectClass = activity.Status switch
                                {
                                    "Approved" => "text-success border-success-subtle bg-success-subtle",
                                    "Rejected" => "text-danger border-danger-subtle bg-danger-subtle",
                                    "Submitted" => "text-info border-info-subtle bg-info-subtle",
                                    _ => "text-secondary border-secondary-subtle bg-secondary-subtle"
                                };
                                Model.LatestSubmissions.TryGetValue(activity.ActivityID, out var submission);

                                <tr>
                                    <td class="fw-semibold">@activity.ActivityName</td>

                                    <td>
                                        <form method="post" asp-page-handler="UpdateActivityStatus">
                                            <input type="hidden" name="activityId" value="@activity.ActivityID" />
                                            <input type="hidden" name="officeTaskId" value="@Model.OfficeTask.OfficeTaskID" />
                                            <select name="status" class="form-select form-select-sm fw-semibold @selectClass"
                                                    onchange="this.form.submit()">
                                                <option value="Pending" selected="@(activity.Status == "Pending")">Pending</option>
                                                <option value="Submitted" selected="@(activity.Status == "Submitted")">Submitted</option>
                                                <option value="Approved" selected="@(activity.Status == "Approved")">Approved</option>
                                                <option value="Rejected" selected="@(activity.Status == "Rejected")">Rejected</option>
                                            </select>
                                        </form>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (submission != null)
                                            {
                                                <a asp-page-handler="Download" asp-route-submissionId="@submission.SubmissionID"
                                                   class="small text-truncate" style="max-width:110px;" title="@submission.FileName">
                                                    @submission.FileName
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No file</span>
                                            }
                                            <form method="post" asp-page-handler="UploadSubmission" enctype="multipart/form-data" class="m-0 p-0">
                                                <input type="hidden" name="activityId" value="@activity.ActivityID" />
                                                <input type="hidden" name="officeTaskId" value="@Model.OfficeTask.OfficeTaskID" />
                                                <label class="btn btn-sm btn-outline-secondary py-0 px-1 mb-0" title="Upload submission">
                                                    <i class="bi bi-upload"></i>
                                                    <input type="file" name="submissionFile" class="d-none" onchange="this.form.submit()" />
                                                </label>
                                            </form>
                                        </div>
                                    </td>

                                    <td>
                                        <form method="post" asp-page-handler="UpdateActivityFeedback" class="d-flex gap-1">
                                            <input type="hidden" name="activityId" value="@activity.ActivityID" />
                                            <input type="hidden" name="officeTaskId" value="@Model.OfficeTask.OfficeTaskID" />
                                            <input type="text" name="feedback" value="@activity.FeedBack"
                                                   class="form-control form-control-sm" placeholder="Add feedback..." maxlength="500" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Save feedback">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>

                                    <td class="text-end">
                                        <form method="post" asp-page-handler="RemoveActivity"
                                              onsubmit="return confirm('Delete this activity?');">
                                            <input type="hidden" name="activityId" value="@activity.ActivityID" />
                                            <input type="hidden" name="officeTaskId" value="@Model.OfficeTask.OfficeTaskID" />
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-1" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-muted text-center py-3">No activities yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-muted small mt-2">
                Task status updates automatically from activity statuses: all Approved marks the task Completed;
                any Submitted or Approved sets it to In Progress.
            </div>
        </div>
    </div>

    @* ===================== SAVE / CANCEL ===================== *@
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
        <form method="post" asp-page-handler="Save" class="m-0 p-0">
            <input type="hidden" name="officeTaskId" value="@Model.OfficeTask.OfficeTaskID" />
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>
