@page "{id:int}"
@model TM_PE.Pages.OfficeTask.EditModel

@{
    ViewData["Title"] = "Edit Task";
}

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h3 class="fw-bold">Edit Task</h3>
            <p class="text-muted">
                Update the task details, reassign employees, or adjust its activities.
            </p>

            <form method="post" id="taskForm">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="OfficeTask.OfficeTaskID" />

                <!-- Task Number + Date Created -->
                <div class="row mb-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            # Task Number
                        </label>

                        <input class="form-control"
                               value="@Model.OfficeTask.TaskNumber"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Date Created
                        </label>

                        <input class="form-control"
                               value="@Model.OfficeTask.DateCreated.ToString("MM/dd/yyyy")"
                               disabled />
                    </div>

                </div>

                <!-- Task Name -->
                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Task Name <span class="text-danger">*</span>
                    </label>

                    <input asp-for="OfficeTask.TaskName"
                           class="form-control"
                           placeholder="e.g. Quarterly inventory audit" />

                    <span asp-validation-for="OfficeTask.TaskName"
                          class="text-danger"></span>

                </div>

                <!-- Description -->
                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="OfficeTask.Description"
                              rows="4"
                              class="form-control"
                              placeholder="Instructions, objectives, or additional details..."></textarea>

                    <span asp-validation-for="OfficeTask.Description"
                          class="text-danger"></span>

                </div>

                <!-- Due Date, Status, Progress -->
                <div class="row mb-4">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Due Date <span class="text-danger">*</span>
                        </label>

                        <input asp-for="OfficeTask.DueDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="OfficeTask.DueDate"
                              class="text-danger"></span>
                    </div>

                    @* <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select asp-for="OfficeTask.Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Overdue">Overdue</option>
                        </select>

                        <span asp-validation-for="OfficeTask.Status"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Progress (%)
                        </label>

                        <input asp-for="OfficeTask.Progress"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control" />

                        <span asp-validation-for="OfficeTask.Progress"
                              class="text-danger"></span>
                    </div> *@

                </div>

                <!-- Assign Employees -->
                <div class="card mb-3">
                    <div class="card-body">

                        <h5 class="fw-semibold mb-3">
                            👥 Assign Employees <span class="text-danger">*</span>
                        </h5>

                        <div class="row">

                            <div class="col-md-10">

                                <select id="employeeSelect" class="form-select">
                                    <option value="">Select an employee</option>
                                    @foreach (var emp in Model.EmployeeList)
                                    {
                                        <option value="@emp.EmployeeId">@emp.FullName</option>
                                    }
                                </select>

                            </div>

                            <div class="col-md-2">

                                <button type="button"
                                        id="addEmployeeBtn"
                                        class="btn btn-primary w-100">
                                    + Add
                                </button>

                            </div>

                        </div>

                        <!-- Selected Employees -->
                        <div id="selectedEmployees" class="mt-3">
                            <span class="text-muted small" id="noEmployeesMsg">No employees added yet.</span>
                        </div>

                    </div>
                </div>

                <!-- Activities -->
                <div class="card mb-4">
                    <div class="card-body">

                        <h5 class="fw-semibold mb-3">
                            📋 Task Activities <span class="text-danger">*</span>
                        </h5>

                        <div class="row">

                            <div class="col-md-10">

                                <input type="text"
                                       id="activityInput"
                                       class="form-control"
                                       placeholder="Enter an activity name" />

                            </div>

                            <div class="col-md-2">

                                <button type="button"
                                        id="addActivityBtn"
                                        class="btn btn-primary w-100">
                                    + Add
                                </button>

                            </div>

                        </div>

                        <!-- Activities List -->
                        <ul id="activitiesList" class="list-group mt-3">
                            <li class="list-group-item text-muted small" id="noActivitiesMsg">No activities added yet.</li>
                        </ul>

                    </div>
                </div>

                <!-- Footer Buttons -->
                <div class="text-end">

                    <a asp-page="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const employeeSelect = document.getElementById('employeeSelect');
            const addEmployeeBtn = document.getElementById('addEmployeeBtn');
            const selectedEmployeesDiv = document.getElementById('selectedEmployees');
            const noEmployeesMsg = document.getElementById('noEmployeesMsg');

            const activityInput = document.getElementById('activityInput');
            const addActivityBtn = document.getElementById('addActivityBtn');
            const activitiesList = document.getElementById('activitiesList');
            const noActivitiesMsg = document.getElementById('noActivitiesMsg');

            const addedEmployeeIds = new Set();

            function addEmployeeBadge(id, name) {
                if (!id || addedEmployeeIds.has(id)) return;

                addedEmployeeIds.add(id);
                noEmployeesMsg.style.display = 'none';

                const badge = document.createElement('span');
                badge.className = 'badge bg-primary me-2 p-2';
                badge.dataset.employeeId = id;
                badge.innerHTML = `${name} <span class="ms-2" style="cursor:pointer;" onclick="removeEmployee('${id}')">&times;</span>`;

                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = 'SelectedEmployeeIds';
                hiddenInput.value = id;
                hiddenInput.dataset.employeeId = id;

                selectedEmployeesDiv.appendChild(badge);
                selectedEmployeesDiv.appendChild(hiddenInput);
            }

            addEmployeeBtn.addEventListener('click', function () {
                const id = employeeSelect.value;
                const name = employeeSelect.options[employeeSelect.selectedIndex].text;

                addEmployeeBadge(id, name);
                employeeSelect.value = '';
            });

            window.removeEmployee = function (id) {
                addedEmployeeIds.delete(id);
                selectedEmployeesDiv
                    .querySelectorAll(`[data-employee-id="${id}"]`)
                    .forEach(el => el.remove());

                if (addedEmployeeIds.size === 0) {
                    noEmployeesMsg.style.display = '';
                }
            };

            let activityCounter = 0;

            function addNewActivityRow(text) {
                activityCounter++;
                const activityId = `new-activity-${activityCounter}`;
                noActivitiesMsg.style.display = 'none';

                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';
                li.dataset.activityId = activityId;
                li.innerHTML = `
                    <span>${text}</span>
                    <span class="text-danger" style="cursor:pointer;" onclick="removeActivity('${activityId}')">&times;</span>
                    <input type="hidden" name="NewActivities" value="${text.replace(/"/g, '&quot;')}" />
                `;

                activitiesList.appendChild(li);
            }

            function addExistingActivityRow(activityId, text, statusLabel) {
                noActivitiesMsg.style.display = 'none';

                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';
                li.dataset.activityId = `existing-${activityId}`;
                li.innerHTML = `
                    <span>${text} ${statusLabel ? `<span class="badge bg-secondary-subtle text-secondary ms-2">${statusLabel}</span>` : ''}</span>
                    <span class="text-danger" style="cursor:pointer;" onclick="removeActivity('existing-${activityId}')">&times;</span>
                    <input type="hidden" name="KeptActivityIds" value="${activityId}" />
                `;

                activitiesList.appendChild(li);
            }

            addActivityBtn.addEventListener('click', function () {
                const text = activityInput.value.trim();
                if (!text) return;

                addNewActivityRow(text);
                activityInput.value = '';
                activityInput.focus();
            });

            activityInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addActivityBtn.click();
                }
            });

            window.removeActivity = function (id) {
                const li = activitiesList.querySelector(`[data-activity-id="${id}"]`);
                if (li) li.remove();

                if (activitiesList.querySelectorAll('li[data-activity-id]').length === 0) {
                    noActivitiesMsg.style.display = '';
                }
            };

            // ---- Pre-fill with existing assignments and activities ----
            @foreach (var a in Model.OfficeTask.Assignments.Where(a => a.Employee != null))
            {
                        @: addEmployeeBadge(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(a.EmployeeID.ToString())), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(a.Employee!.FullName)));
            }

            @foreach (var act in Model.OfficeTask.Activities)
            {
                        @: addExistingActivityRow(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(act.ActivityID.ToString())), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(act.ActivityName)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(act.Status)));
            }
        })();
    </script>
}
