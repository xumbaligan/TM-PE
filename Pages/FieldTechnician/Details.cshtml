@page "{id:int}"
@model TM_PE.Pages.FieldTechnician.DetailsModel
@{
    ViewData["Title"] = "Job Order Details";
    Layout = "_FieldTechnicianLayout";
    var badgeClass = Model.JobTicket.Status switch
    {
        "Closed" => "bg-primary-subtle text-primary",
        "Completed" => "bg-success-subtle text-success",
        "In Progress" => "bg-info-subtle text-info",
        "Cancelled" => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}



@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="fw-bold mb-0">@Model.JobTicket.JobType Job</h4>
        <div class="text-muted small">
            Ticket #@Model.JobTicket.TicketNumber &middot; Viewing as <strong>@Model.CurrentEmployee.FullName</strong>
            @if (Model.IsLeader)
            {
                <span class="badge bg-primary ms-1">Leader</span>
            }
            else
            {
                <span class="badge bg-light text-dark border ms-1">Member (view only)</span>
            }
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-4">

        <div class="row g-3 mb-3">
            <div class="col-sm-3">
                <div class="text-muted small">Status</div>
                <span class="badge rounded-pill @badgeClass px-3 py-2">@Model.JobTicket.Status</span>
            </div>
            <div class="col-sm-3">
                <div class="text-muted small">@Model.JobTicket.ServiceDateLabel</div>
                <div>@Model.JobTicket.ServiceDate.ToString("M/d/yyyy")</div>
            </div>
            <div class="col-sm-3">
                @if (Model.JobTicket.JobType == "Installation")
                {
                    <div class="text-muted small">Fiber Plan</div>
                    <div>₱@Model.JobTicket.FiberPlan / month</div>
                }
                else
                {
                    <div class="text-muted small">Description</div>
                    <div>@Model.JobTicket.Description</div>
                }
            </div>
            <div class="col-sm-3">
                <div class="text-muted small">Date Created</div>
                <div>@Model.JobTicket.DateCreated.ToString("M/d/yyyy")</div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-4">
                <div class="text-muted small">Client</div>
                <div>@Model.JobTicket.ClientFullName</div>
            </div>
            <div class="col-sm-4">
                <div class="text-muted small">Primary Number</div>
                <div>@Model.JobTicket.PrimaryNumber</div>
            </div>
            <div class="col-sm-4">
                <div class="text-muted small">Secondary Number</div>
                <div>@(string.IsNullOrWhiteSpace(Model.JobTicket.SecondaryNumber) ? "—" : Model.JobTicket.SecondaryNumber)</div>
            </div>
        </div>

        <div class="mb-1">
            <div class="text-muted small mb-2">Location</div>
            <div class="mb-2">@Model.JobTicket.LocationAddress</div>
            @if (!string.IsNullOrWhiteSpace(Model.JobTicket.NearestLandmark))
            {
                <div class="text-muted small">Nearest Landmark</div>
                <div>@Model.JobTicket.NearestLandmark</div>
            }
        </div>

    </div>
</div>

@* ===================== ASSIGNED TEAM ===================== *@
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-4">
        <h6 class="fw-bold mb-3"><i class="bi bi-people me-1"></i> Assigned Team</h6>

        <div class="d-flex flex-wrap gap-2">
            @if (Model.JobTicket.Assignments != null && Model.JobTicket.Assignments.Any())
            {
                @foreach (var a in Model.JobTicket.Assignments.Where(a => a.Employee != null))
                {
                    var isYou = a.EmployeeID == Model.CurrentEmployee.EmployeeId;
                    <span class="badge rounded-pill @(a.IsLeader ? "bg-primary" : "bg-light text-dark border") px-3 py-2">
                        @a.Employee!.FullName @(a.IsLeader ? "(Leader)" : "") @(isYou ? "(You)" : "")
                    </span>
                }
            }
            else
            {
                <span class="text-muted small">No employees assigned.</span>
            }
        </div>
    </div>
</div>

@* ===================== STATUS + REMARKS (leader only) ===================== *@
@if (Model.IsLeader && !Model.JobTicket.IsLockedFromEditing)
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-flag me-1"></i> Update Status</h6>
            <form method="post" asp-page-handler="Save" id="statusForm">
                <input type="hidden" name="jobTicketId" value="@Model.JobTicket.JobTicketID" />
                <div class="row g-2">
                    <div class="col-sm-4">
                        <label class="form-label small">Status</label>
                        <select id="statusSelect" name="status" class="form-select">
                            @foreach (var opt in TM_PE.Pages.FieldTechnician.DetailsModel.StatusOptions)
                            {
                                <option value="@opt" selected="@(opt == Model.JobTicket.Status)">@opt</option>
                            }
                        </select>
                        <div id="fileRequirementWarning"
                             class="alert alert-warning small mt-2 d-none">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            A photo or file must be uploaded before changing this job order to
                            <strong>In Progress</strong> or <strong>Completed</strong>.
                        </div>
                    </div>
                    <div class="col-sm-8">
                        <label class="form-label small">Remarks</label>
                        <input type="text" name="remarks" class="form-control" maxlength="500"
                               value="@Model.JobTicket.Remarks" placeholder="Optional notes about this update" />
                    </div>
                </div>
            </form>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.JobTicket.Remarks))
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-2"><i class="bi bi-flag me-1"></i> Remarks</h6>
            <div class="text-muted">@Model.JobTicket.Remarks</div>
        </div>
    </div>
}

@* ===================== SUBMITTED PHOTOS / FILES ===================== *@
<div id="submittedFilesSection" class="card shadow-sm border-0 mb-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-1"><i class="bi bi-camera me-1"></i> Submitted Photos / Files</h6>
            <p class="text-muted small mb-3">
                @if (Model.IsLeader)
                {
                    <text>Upload proof-of-work photos or files below. Only you, as team leader, can upload for this job order.</text>
                }
                else
                {
                    <text>You can view and download files uploaded by the team leader. Only the leader can upload.</text>
                }
            </p>

            @if (Model.IsLeader && !Model.JobTicket.IsLockedFromEditing)
            {
                <form method="post" enctype="multipart/form-data" asp-page-handler="UploadSubmission" id="uploadSubmissionForm">
                    <input type="hidden" name="jobTicketId" value="@Model.JobTicket.JobTicketID" />
                    <input type="hidden" name="status" id="uploadStatus" value="@Model.JobTicket.Status" />
                    <div class="d-flex align-items-center gap-2">
                        <input type="file" name="submissionFile" id="submissionFileInput" class="form-control" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" />
                        <span id="uploadSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status" aria-hidden="true"></span>
                    </div>
                    <div class="form-text">Choosing a photo or file uploads it automatically.</div>
                </form>
            }

            @if (Model.JobTicket.Submissions != null && Model.JobTicket.Submissions.Any())
            {
                <div class="row g-3">
                    @foreach (var sub in Model.JobTicket.Submissions)
                    {
                        var ext = System.IO.Path.GetExtension(sub.FileName);
                        var isImage = TM_PE.Pages.FieldTechnician.DetailsModel.ImageExtensions.Contains(ext);
                        <div class="col-md-3 col-sm-4 col-6">
                            <div class="card h-100 position-relative">
                                @if (Model.IsLeader && !Model.JobTicket.IsLockedFromEditing)
                                {
                                    <form method="post" asp-page-handler="DeleteSubmission"
                                          onsubmit="return confirm('Remove this file?');"
                                          class="position-absolute top-0 end-0 m-1">
                                        <input type="hidden" name="jobTicketId" value="@Model.JobTicket.JobTicketID" />
                                        <input type="hidden" name="submissionId" value="@sub.JobTicketSubmissionID" />
                                        <button type="submit" class="btn btn-sm btn-danger rounded-circle p-0"
                                                style="width:24px; height:24px; line-height:1;" title="Remove file">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </form>
                                }
                                @if (isImage)
                                {
                                    <img src="~/@sub.FilePath" class="card-img-top" style="height:150px; object-fit:cover;" alt="@sub.FileName" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light" style="height:150px;">
                                        <i class="bi bi-file-earmark-text" style="font-size:2.5rem;"></i>
                                    </div>
                                }
                                <div class="card-body p-2">
                                    <div class="small text-truncate" title="@sub.FileName">@sub.FileName</div>
                                    <div class="text-muted small">By @(sub.Employee?.FullName ?? "—")</div>
                                    <div class="text-muted small">@sub.DateSubmitted.ToString("M/d/yyyy h:mm tt")</div>
                                    <a asp-page-handler="Download" asp-route-submissionId="@sub.JobTicketSubmissionID" class="btn btn-sm btn-outline-secondary w-100 mt-1">
                                        <i class="bi bi-download"></i> Download
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted">No photos or files submitted yet.</div>
            }
        </div>
    </div>
</div>
<div class="d-flex justify-content-end gap-2 mb-4">
    @if (Model.IsLeader && !Model.JobTicket.IsLockedFromEditing)
    {
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" form="statusForm" class="btn btn-primary">Save</button>
    }
    else
    {
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to My Job Orders</a>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const statusSelect = document.getElementById("statusSelect");
        const submittedFilesSection = document.getElementById("submittedFilesSection");
        const uploadStatus = document.getElementById("uploadStatus");
        const submissionFileInput = document.getElementById("submissionFileInput");
        const uploadSubmissionForm = document.getElementById("uploadSubmissionForm");
        const uploadSpinner = document.getElementById("uploadSpinner");

        // Choosing a file/photo uploads it immediately — no separate Upload button.
        if (submissionFileInput && uploadSubmissionForm) {
            submissionFileInput.addEventListener("change", function () {
                if (submissionFileInput.files && submissionFileInput.files.length > 0) {
                    // Show a spinner and prevent a second, accidental submit while the
                    // page reloads. The file input itself must stay enabled so its
                    // value is actually included in the submitted form data.
                    if (uploadSpinner) {
                        uploadSpinner.classList.remove("d-none");
                    }
                    submissionFileInput.readOnly = true;
                    uploadSubmissionForm.submit();
                }
            });
        }

        if (!statusSelect || !submittedFilesSection) {
            return;
        }

        function updateSubmittedFilesVisibility() {

            const selectedStatus = statusSelect.value;
            // Keep upload form synchronized
            // with the currently selected status.
            if (uploadStatus) {
                uploadStatus.value = selectedStatus;
            }

            if (selectedStatus === "Pending") {
                submittedFilesSection.style.display = "none";
            } else {
                submittedFilesSection.style.display = "";
            }
        }

        // Run immediately when the page loads
        updateSubmittedFilesVisibility();

        // Run immediately when the leader changes the status
        statusSelect.addEventListener("change", function () {
            updateSubmittedFilesVisibility();
        });

    });
</script>
