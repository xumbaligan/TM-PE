@page
@model TM_PE.Pages.OfficeStaff.SelectModel

@{
    ViewData["Title"] = "Employee Task";
    Layout = "_OfficeStaffLayout";
}

<div class="container mt-4" style="max-width: 480px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h3 class="fw-bold"><i class="bi bi-person-workspace me-1"></i> Employee Tasks</h3>
            <p class="text-muted">Select your name to view your assigned tasks.</p>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Your Name</label>
                    <select name="employeeId" class="form-select">
                        <option value="">Select your name</option>
                        @foreach (var emp in Model.OfficeStaff)
                        {
                            <option value="@emp.EmployeeId">@emp.FullName</option>
                        }
                    </select>
                    @if (!Model.OfficeStaff.Any())
                    {
                        <div class="form-text text-warning">No active Office Staff employees found.</div>
                    }
                </div>

                <button type="submit" class="btn btn-primary w-100">Continue</button>
            </form>

        </div>
    </div>
</div>
